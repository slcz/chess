# image carries the base env; deploy/sp_autorun.sh runs the self-play job.
# Exclusions keep the context lean. NOTE: runs/* (not runs) so the ONE
# negated base checkpoint can be re-included — docker cannot re-include a
# file whose parent directory itself is excluded. The negation must trail
# both runs/* and *.pt (user decision 2026-10-10: bake the 42k net into
# the image, no boot-time HF fetch).
.git
.venv
venv
doc
# data/* (not data) so the ONE negated book can be re-included — docker
# cannot re-include a file whose parent directory itself is excluded.
data/*
!data/noob_3moves.epd
runs/*
checkpoints
artifacts
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.DS_Store
engine/build
engine/build-asan
engine/bin
*.pt
!runs/policy_value_net_42k.pt
*.pack
.env
.zcode*
